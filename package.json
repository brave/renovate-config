{
    "name": "renovate-config",
    "version": "1.0.0",
    "description": "Renovate configuration for Brave projects",
    "packageManager": "pnpm@11.22.0",
    "type": "module",
    "scripts": {
        "test": "pnpm test:bdd",
        "test:bdd": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
        "test:validator": "pnpm dlx --package renovate -- renovate-config-validator --strict default.json lockfile-*.json enable-*.json",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/brave/renovate-config.git"
    },
    "keywords": [
        "renovate",
        "config"
    ],
    "author": "Andrea Brancaleoni <abrancaleoni@brave.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/brave/renovate-config/issues"
    },
    "homepage": "https://github.com/brave/renovate-config#README.md",
    "dependencies": {
        "renovate": "44.32.2"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^13.2.1",
        "@types/node": "^26.3.0",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
